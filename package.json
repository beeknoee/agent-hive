{
  "name": "agent-hive",
  "version": "0.1.2",
  "description": "Low-poly 3D office for AI agent teams — each agent is an employee who walks, works and gathers by real status (Three.js). Made by Beeknoee.",
  "author": "Beeknoee (https://beeknoee.com)",
  "homepage": "https://github.com/beeknoee/agent-hive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeknoee/agent-hive.git"
  },
  "bugs": {
    "url": "https://github.com/beeknoee/agent-hive/issues"
  },
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "demo": "vite demo --port 5190",
    "demo:build": "vite build demo --outDir ../dist-demo --emptyOutDir",
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "three": ">=0.160.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "three": "0.169.0",
    "vite": "5.4.21"
  },
  "keywords": [
    "ai-agents",
    "three.js",
    "isometric",
    "low-poly",
    "dashboard",
    "office",
    "visualization",
    "ai",
    "agents",
    "threejs",
    "react",
    "beeknoee"
  ]
}
